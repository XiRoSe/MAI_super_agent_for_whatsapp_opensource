# =============================================================================
# Mai — environment configuration (copy to .env and fill in)
#
# Never commit a real .env — all secrets are read from the environment.
# Every variable below maps 1:1 to a field in backend/config.py, except the
# "Docker Compose" section at the top, which only docker-compose.yml reads.
#
# MINIMAL BOOT (everything else is optional):
#   MAI_JWT_SECRET       — dashboard login tokens
#   MAI_ENCRYPTION_KEY   — encrypts stored credentials at rest
#   MAI_DB_URL           — defaults to local SQLite; set Postgres in production
#   ONE model provider   — e.g. MODEL_PROVIDER=together + TOGETHER_API_KEY
#
# Docker Compose users additionally need GOWA_PASSWORD and GOWA_WEBHOOK_SECRET
# (next section) — compose refuses to start without them.
# =============================================================================

# ---- Docker Compose only (read by docker-compose.yml, not backend/config.py) --
# Compose wires these into BOTH services so the values always match. Ignore this
# section if you are not using the provided docker-compose.yml.
# Basic-auth user Mai uses to talk to the gateway (compose default: mai).
GOWA_USER=mai
# REQUIRED for compose: basic-auth password for the gateway — any strong password.
GOWA_PASSWORD=
# REQUIRED for compose: HMAC secret for gateway -> Mai webhooks (openssl rand -hex 32).
GOWA_WEBHOOK_SECRET=
# Postgres password for the bundled postgres service (compose default: mai — change it).
POSTGRES_PASSWORD=

# ---- Core -------------------------------------------------------------------
# Runtime environment: local | beta | production (production fails closed on missing secrets).
MAI_ENV=local
# Log verbosity: DEBUG | INFO | WARNING | ERROR.
MAI_LOG_LEVEL=INFO
# If true, logs full message text — DEV ONLY, never in production.
MAI_LOG_MESSAGE_BODIES=false

# ---- Database ---------------------------------------------------------------
# SQLAlchemy URL. REQUIRED for a real deployment (default is a throwaway local SQLite).
#   sqlite:   sqlite:///tmp/mai.db
#   postgres: postgresql+psycopg://USER:PASS@HOST:PORT/DBNAME
MAI_DB_URL=sqlite:///tmp/mai.db

# ---- Model providers --------------------------------------------------------
# REQUIRED: pick ONE provider and set its API key. Switch the whole app's brain
# with one variable — no code changes.
# Provider: together | anthropic | openrouter.
MODEL_PROVIDER=together
# Model id at that provider (e.g. zai-org/GLM-5.2, claude-sonnet-4-6, or an OpenRouter slug).
MODEL_ID=zai-org/GLM-5.2
# Sampling temperature.
MODEL_TEMPERATURE=0.4
# Reply-length budget; reasoning models spend thinking tokens from the same budget, keep it high.
MODEL_MAX_TOKENS=16384
# Cache the static prompt prefix where the provider supports it (cheaper, faster).
MODEL_ENABLE_PROMPT_CACHING=true
# Auto-retries on transient provider errors before giving up.
MODEL_RETRIES=2
# Optional fallback provider/model used automatically when the primary fails a turn.
FALLBACK_MODEL_PROVIDER=
FALLBACK_MODEL_ID=

# Anthropic (MODEL_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
# Together AI, OpenAI-compatible (MODEL_PROVIDER=together). Also powers the
# semantic-recall embedder and the code-exec guardrail — leave empty to run without those.
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
# OpenRouter, OpenAI-compatible (MODEL_PROVIDER=openrouter).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Security / keys --------------------------------------------------------
# REQUIRED: HMAC secret signing dashboard JWTs — generate a long random string.
MAI_JWT_SECRET=
# JWT lifetime in hours (720 = 30 days).
JWT_EXPIRY_HOURS=720
# Comma-separated allowed frontend origins, or * for any.
CORS_ORIGINS=*
# REQUIRED: Fernet key encrypting stored credentials/OAuth tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAI_ENCRYPTION_KEY=
# Key-encryption-key wrapping the message-store epoch keys: base64 of 32 random bytes
# (any strong secret works — non-base64 values are SHA-256-derived). REQUIRED in
# production; set it via your platform's secret manager (e.g. a Railway sealed variable).
# Off-prod an ephemeral per-process KEK is generated.
MAI_KEK=
# Rolling encrypted-message-store window in days (current + previous epoch).
MAI_SEAL_RETENTION_DAYS=4
# Bearer token gating the /admin ops endpoints; empty disables them.
MAI_ADMIN_TOKEN=
# Comma-separated emails allowed into the admin CRM (and flagged is_admin on
# GET /api/account). Empty = no admins.
MAI_ADMIN_EMAILS=
# Shared token the WhatsApp gateway presents to fetch the current seal public key
# from GET /internal/seal-pubkey. Empty is allowed only outside production.
SEAL_PUBKEY_TOKEN=

# ---- WhatsApp gateway (GOWA) --------------------------------------------------
# Provider: gowa (unofficial gateway: per-user numbers via QR, no Meta account)
#         | meta (official Meta Cloud API) | twilio.
WHATSAPP_PROVIDER=gowa

# -- Unofficial gateway (WHATSAPP_PROVIDER=gowa; also works with WAHA/Evolution) --
# Base URL of your gateway instance, e.g. https://gowa.example.com.
WHATSAPP_GATEWAY_URL=
# Basic-auth user (GOWA) or blank.
WHATSAPP_GATEWAY_USER=
# Basic-auth password (GOWA) or blank.
WHATSAPP_GATEWAY_PASSWORD=
# X-Api-Key header (WAHA/Evolution) or blank.
WHATSAPP_GATEWAY_API_KEY=
# HMAC secret verifying inbound gateway webhooks.
WHATSAPP_GATEWAY_WEBHOOK_SECRET=
# How many recent messages of the tagged chat Mai gets as context.
WHATSAPP_CONTEXT_MESSAGES=10

# -- Official Meta Cloud API (WHATSAPP_PROVIDER=meta) --
# Token used to verify the webhook subscription handshake.
WHATSAPP_VERIFY_TOKEN=
# App secret validating inbound webhook signatures.
WHATSAPP_APP_SECRET=
# Graph API access token for sending.
WHATSAPP_ACCESS_TOKEN=
# The business phone-number id messages are sent from.
WHATSAPP_PHONE_NUMBER_ID=
# Graph API version.
WHATSAPP_API_VERSION=v21.0

# ---- Server -----------------------------------------------------------------
# HTTP port the API listens on.
PORT=7777
# Public base URL of this deployment (webhooks, OAuth callbacks, media links).
PUBLIC_BASE_URL=http://localhost:7777

# ---- Optional: Replicate (media understanding & generation) ------------------
# API token; empty disables run_model and inbound media understanding.
REPLICATE_API_TOKEN=
# Model answering questions about inbound images.
REPLICATE_VISION_MODEL=andreasjansson/blip-2
# Model transcribing inbound voice notes.
REPLICATE_TRANSCRIBE_MODEL=openai/whisper
# Optional video-understanding model; empty = videos aren't read.
REPLICATE_VIDEO_MODEL=

# ---- Optional: code execution (run_python in an E2B sandbox) -----------------
# Master switch for the run_python tool.
CODE_EXEC_ENABLED=false
# E2B API key for the cloud sandbox.
E2B_API_KEY=
# Sandbox script wall-clock limit in seconds.
CODE_EXEC_TIMEOUT_SECONDS=300
# Max outbound sends a single sandbox run may perform.
CODE_EXEC_SEND_CAP=10
# Lifetime of the sandbox's callback token in seconds.
CODE_EXEC_TOKEN_TTL_SECONDS=300
# Truncate a sandbox run's result to this many characters.
CODE_EXEC_MAX_RESULT_CHARS=6000
# Public base URL the sandbox calls back to; empty = derive from PORT.
SDK_BASE_URL=
# CodeAct mode: data/gen tools become reachable ONLY via run_python code.
CODEACT_MODE=false

# ---- Optional: separate sandbox runner service --------------------------------
# Base URL of a dedicated runner service; empty = run sandboxes in-process.
RUNNER_URL=
# Shared secret authenticating Mai <-> runner calls.
RUNNER_SHARED_SECRET=

# ---- Optional: code-exec guardrail (pre-flight LLM screen; needs TOGETHER_API_KEY) --
# Screen generated code before it runs.
GUARDRAIL_ENABLED=true
# Fast model doing the screening.
GUARDRAIL_MODEL=Qwen/Qwen2.5-7B-Instruct-Turbo

# ---- Optional: agent behavior --------------------------------------------------
# Max tool calls per turn so the loop always ends with a text reply.
AGENT_TOOL_CALL_LIMIT=6
# Agno reasoning: think step-by-step before acting (slower, more tokens).
AGENT_REASONING=false
# Hard cap on a single agent run in seconds; must exceed CODE_EXEC_TIMEOUT_SECONDS.
AGENT_RUN_TIMEOUT_SECONDS=420

# ---- Optional: skills -----------------------------------------------------------
# Directory of SKILL.md packages; drop a folder in to add a skill.
SKILLS_DIR=skills
# How skills reach the agent: vector (semantic recall injects full bodies; needs the
# embedder) | stub (name+description only; model fetches bodies on demand).
SKILL_MODE=vector

# ---- Optional: semantic recall (needs TOGETHER_API_KEY; auto-disables without it) --
# Inject only the RELEVANT memories/skills per turn instead of all of them.
SEMANTIC_RECALL_ENABLED=true
# Hosted embedding model (multilingual).
EMBED_MODEL=intfloat/multilingual-e5-large-instruct
# Max memories injected per turn.
MEMORY_RECALL_TOP_K=8
# Cosine-similarity floors for including a memory / a skill.
MEMORY_RECALL_THRESHOLD=0.75
SKILL_RECALL_THRESHOLD=0.78

# ---- Optional: LLM tool router (off by default; experimental) --------------------
# Pre-route which optional toolkits a turn needs.
TOOL_ROUTER_ENABLED=false
# Router model id; empty = use the main model.
TOOL_ROUTER_MODEL_ID=
# Fall back to the full toolset if routing takes longer than this (seconds).
TOOL_ROUTER_TIMEOUT_SECONDS=20

# ---- Optional: belief system (background self-reflection) ------------------------
# Mai keeps an evolving perspective on each user.
BELIEF_SYSTEM_ENABLED=true
# Reflect once every N user messages.
BELIEF_REFLECT_EVERY=5

# ---- Optional: scheduler ----------------------------------------------------------
# Run the schedule poller (reminders, recurring tasks).
SCHEDULER_ENABLED=true
# Seconds between poll cycles.
SCHEDULER_POLL_INTERVAL=15
# Max active schedules per user.
MAX_ACTIVE_SCHEDULES_PER_USER=20
# Smallest allowed recurrence interval in minutes.
MIN_SCHEDULE_INTERVAL_MINUTES=1

# ---- Optional: quotas ---------------------------------------------------------------
# Per-account daily message cap.
QUOTA_MESSAGES_PER_DAY=200
# Per-account monthly token cap.
QUOTA_TOKENS_PER_MONTH=2000000

# ---- Optional: billing (Polar.sh) ----------------------------------------------------
# Leave all empty to run without billing (self-hosted default).
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# sandbox | production.
POLAR_SERVER=sandbox
# Where Polar redirects after a successful checkout.
POLAR_SUCCESS_URL=https://mai.example.com/billing/success
# The subscription product to check out.
POLAR_PRODUCT_ID=

# ---- Optional: Google OAuth (Drive/Docs knowledge base) -------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Empty = derived as PUBLIC_BASE_URL/oauth/google/callback.
GOOGLE_REDIRECT_URI=
